# Django Secret Key (Generate a new secure key for production)
SECRET_KEY=

# Set to False in production, True for local development
DEBUG=False

# Database URL
# Local SQLite (default if left empty): sqlite:///db.sqlite3
# Supabase PostgreSQL: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres?sslmode=require
DATABASE_URL=

# Allowed Hosts (comma-separated). On Render, RENDER_EXTERNAL_HOSTNAME is automatically added.
ALLOWED_HOSTS=

# CSRF Trusted Origins (comma-separated, e.g., https://your-app.onrender.com)
CSRF_TRUSTED_ORIGINS=

# SMS Provider API Token (bdbulksms)
SMS_TOKEN=

# School Details (Optional custom branding)
SCHOOL_SHORT_NAME=Shaheed Nur Hossain Memorial School
SCHOOL_FULL_NAME=Shaheed Nur Hossain Memorial School, Biral, Dinajpur
